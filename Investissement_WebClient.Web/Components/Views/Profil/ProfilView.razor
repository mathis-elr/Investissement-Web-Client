@page "/"
@attribute [Authorize]
@inject ProfilViewModel PVM
@inject IJSRuntime JS
@inject IToastService TS
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<PageTitle>Profil</PageTitle>

<div class="profil">
    <div class="perspectives">
        <div class="header">
            <label>Perspectives</label>
        </div>

        <div class="content">
            <div class="perspectives-infos">
                <div class="form-grid">
                    <label>Investissement mensuel</label>
                    <div class="info">
                        <input @bind="PVM.InvestissementMoyenMensuel" @bind:event="oninput" @onchange="CalculerEvolutionDuPatrimoine" />
                    </div>
                    <label>€</label>

                    <label>Evolution Annuelle</label>
                    <div class="info">
                        <input @bind="PVM.EvolutionAnnuellePourcentage" @bind:event="oninput" @onchange="CalculerEvolutionDuPatrimoine" />
                    </div>
                    <label>%</label>

                    <label>Nombre d'années</label>
                    <div class="info">
                        <input @bind="PVM.PerspectiveNbAnnees" @bind:event="oninput" @onchange="CalculerEvolutionDuPatrimoine" />
                    </div>
                    <label>ans</label>
                </div>
            </div>

            <div class="perspectives-graphique @(PVM.RecuparationEnCours ? "graphique-centre" : "")">
                @if (PVM.RecuparationEnCours)
                {
                    <_ChargementGraphique />
                }
                else
                {
                    <_GraphiquePerspectivePatrimoine Model="@PVM" />
                }
            </div>
        </div>
    </div>

    <div class="info-compte">
        <div class="header">
            <label>Bonjour @(PVM.PrenomUser != string.Empty ? PVM.PrenomUser : "")</label>
            <button class="btn-deconnexion" title="Déconnexion" @onclick="Deconnexion"><img src="icons/logout.svg" /></button>
        </div>

        <div class="content">
            <div class="info">
                <img src="icons/wallet.svg" />
                <span>Valeur Actuelle</span>
                <span class="blanc fw-bolder">
                    @(PVM.ValeurPatrimoineCourante == 0 ? "--,--" : PVM.ToStringPourcentage(PVM.ValeurPatrimoineCourante, "C2"))
                </span>
            </div>

            <div class="info">
                <img src="icons/gain.svg" />
                <span>Gain total</span>
                <span class="@PVM.DeterminerClasse(PVM.GainTotal) fw-bolder">
                    @(PVM.GainTotal == 0 ? "--,--": $"{(PVM.GainTotal > 0 ? "+" : "")}{PVM.ToStringPourcentage(PVM.GainTotal, "C2")}")
                </span>
            </div>

            <div class="info">
                <img src="icons/asset.svg" />
                <span>Actifs suivis</span>
                <span class="blanc fw-bolder">
                    @PVM.NombreActifs
                </span>
            </div>

            <div class="info">
                <img src="icons/calendar.svg" />
                <span>Investisseur depuis</span>
                <span class="blanc fw-bolder">
                    @PVM.NombreAnnes ans
                    et
                    @PVM.NombreMois mois
                </span>
            </div>
        </div>
    </div>

    <div class="repartition-actifs">
        <div class="header">
            <label>Allocation</label>
        </div>

        <div class="graphique @(PVM.RecuparationEnCours ? "graphique-centre" : "")">
            @if (PVM.RecuparationEnCours)
            {
                <_ChargementGraphique />
            }
            else
            {
                <_GraphiqueRepartitionActifs Model="@PVM" />
            }
        </div>
    </div>
</div>

@code {
    private CancellationTokenSource _cts = new();
    [Parameter][SupplyParameterFromQuery(Name = "creation")] public string? CreationStatus { get; set; }

    protected override async Task OnInitializedAsync()
    {
        PVM.OnChange += StateHasChanged;

        if (CreationStatus == "succes")
            TS.ShowSuccess("Votre compte a été créé avec succès !");

        await PVM.LoadData();
       
        if (PVM.HasError)
        {
            TS.ShowError(PVM.ErrorMessage);
            PVM.HasError = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ = LoadDataBoucle(_cts.Token);
        }
    }

    private async Task LoadDataBoucle(CancellationToken stoppingToken)
    {
        try
        {
            while (!stoppingToken.IsCancellationRequested)
            {
                await PVM.LoadInfosProfil();
                StateHasChanged();
                await Task.Delay(TimeSpan.FromSeconds(10), stoppingToken);
            }
        }
        catch (OperationCanceledException) { }
    }

    public void CalculerEvolutionDuPatrimoine()
    {
        PVM.CalculerEvolutionDuPatrimoine();

        if (PVM.HasError)
        {
            TS.ShowError(PVM.ErrorMessage);
            PVM.HasError = false;
            PVM.ErrorMessage = string.Empty;
        }
    }

    public async Task Deconnexion()
    {
        var customAuthStateProvider = (CustomAuthStateProvider)AuthStateProvider;
        await customAuthStateProvider.UpdateAuthenticationState(null);

        Nav.NavigateTo("connexion");
    }

    public void Dispose()
    {
        PVM.OnChange -= StateHasChanged;
        _cts.Cancel();
        _cts.Dispose();
    }

}