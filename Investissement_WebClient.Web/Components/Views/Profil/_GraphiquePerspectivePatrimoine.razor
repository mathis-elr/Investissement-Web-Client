@if (Model.RecuparationEnCours)
{
    <_ChargementGraphique />
}
else
{
    <ApexChart @ref="_chart"
               TItem="ValeurParAnLineChartDto"
               Options="ProfilChartsOptions.OptionsValeurParAn">

        <ApexPointSeries TItem="ValeurParAnLineChartDto"
                         Items="Model.PerspectivesValeurPatrimoineParAn"
                         SeriesType="SeriesType.Line"
                         Name="Valeur Patrimoine"
                         YValue="@(e => e.Valeur)"
                         XValue="@(e => e.Annee)"
                         Stroke="@(new SeriesStroke{ Width=3, DashSpace=2, Color="goldenrod" })" />

        <ApexPointSeries TItem="ValeurParAnLineChartDto"
                         Items="Model.PerspectivesValeurPatrimoineParAn"
                         SeriesType="SeriesType.Line"
                         Name="Investissement"
                         YValue="@(e => e.Investissement)"
                         XValue="@(e => e.Annee)"
                         Stroke="@(new SeriesStroke{ Width=3, Color="grey" })" />
    </ApexChart>
}

@code {
    [Parameter] public required ProfilViewModel Model { get; set; }
    private ApexChart<ValeurParAnLineChartDto>? _chart { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (_chart != null)
        {
            await _chart.UpdateSeriesAsync();
        }
    }
}
