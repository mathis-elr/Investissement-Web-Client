<div class="header">
    <label>Historique</label>

    @if (Model.ConnexionBanqueRequise)
    {
        <p class="fst-italic">Banque non synchronisée</p>
    }
    else if (Model.DateExpirationSync.HasValue)
    {
        <p class="fst-italic">Banque synchronisée jusqu'au @Model.DateExpirationSync!.Value.ToString("dd MMM")</p>
    }
</div>

<div class="un-mois recap @(Model.DateActive == null ? "active-recapitulatif-global " : "")"
     @onclick="Model.SetRecapGlobalMode">
    <span>Récapitulatif global</span>
</div>

<div class="content">

    @foreach (var unMois in Model.StatutsParMois)
    {
        var estIndisponible = false;
        var icon = string.Empty;
        var statut = string.Empty;
        @switch (unMois.Statut)
        {
            case Statut.indisponible:
                estIndisponible = true;
                icon = "indisponible";
                statut = "indisponible";
                break;
            case Statut.a_completer:
                icon = "non-complete";
                statut = "à compléter";
                break;
            case Statut.complete:
                icon = "complete";
                statut = "complété";
                break;
            case Statut.aucune_donnees:
                icon = "aucune-donnee";
                statut = "aucune données";
                break;
            case Statut.edition:
                icon = "edition";
                statut = "édition";
                break;
        }

        var estActif = Model.DateActive.HasValue
                    && Model.DateActive.Value.Year == unMois.Date.Year
                    && Model.DateActive.Value.Month == unMois.Date.Month;

        <div class="un-mois @(estIndisponible || Model.ConnexionBanqueRequise ? "disabled" : estActif ? "active" : "")"
             @onclick="() => { if (!estIndisponible && !Model.ConnexionBanqueRequise) { Model.LoadFluxUnMois(unMois); } }"
             title="@(Model.ConnexionBanqueRequise ? "Connexion à une banque requise" : estIndisponible ? $"Vous pourrez voir vox flux à partir du 5 {unMois.Date.AddMonths(1).ToString("MMMM yyyy")}" : "Cliquer pour consulter les flux du mois")">

            <div class="gauche">
                <img src='/icons/@(icon + ".svg")' />
                <span class="mois">@unMois.Date.ToString("MMMM yyyy")</span>
            </div>
            <span class="statut-badge">@statut</span>
        </div>
    }
</div>


@code{
    [Parameter] public required BudgetViewModel Model { get; set; }
}