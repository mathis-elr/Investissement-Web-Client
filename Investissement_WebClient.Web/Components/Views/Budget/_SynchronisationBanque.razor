@inject NavigationManager Nav

<div class="connexion-bancaire">
    <div class="icon-banque">🏦</div>
    <label>Banque non-synchronisée</label>

    <span>Connectez votre banque en toute sécurité grâce à 
        <a href="https://www.powens.com/fr/blog/comment-fonctionne-lopen-banking/" target="_blank">Powens</a>
        afin de récupérer vos flux et analyser votre budget
    </span>

    <button type="button" class="btn-submit"
            @onclick="RedirigerVersPowens"
            title="Votre accès bancaire doit être renouvelé pour récupérer les derniers flux (sécurité tous les 90 jours).">
        <img src="icons/sync.svg" />
        Synchroniser ma banque
    </button>
</div>

@code {
    [Parameter] public required BudgetViewModel Model { get; set; }

    public void RedirigerVersPowens()
    {
        Nav.NavigateTo(Model.UrlConnexionPowens, forceLoad: true);
    }
}