@page "/budget"
@attribute [Authorize]
@inject BudgetViewModel BVM
@inject IToastService TS
@inject RecuperationFluxBancairesWorker BankWorker
@implements IDisposable
@inject NavigationManager Nav

<PageTitle>Budget</PageTitle>

@if (BVM.AucunCompteBancaire)
{
    <div class="bloc-empty">
        <_EmptyStateCard Icone="icons/wallet.svg"
                         Titre="Aucun compte bancaire synchronisé"
                         Description="Connectez votre première banque afin de récupérer les flux de vos compte et analyser votre budget."
                         TexteBouton="Synchroniser mes comptes"
                         OnClick="@SynchroniserBanque" />
    </div>
}

<div class="budget">
    <div class="comptes @(BVM.AucunCompteBancaire ? "flou" : "")">
        @if (!BVM.AucunCompteBancaire)
        {
            @foreach (var compte in BVM.ComptesBanque)
            {
                <_CompteBancaire Compte="@compte" Selectionne="@BVM.CompteSelectionne" OnClick="@(async () => await BVM.ChangerCompteSelectionne(compte))" />
            }
        }
        else
        {
            <p>Aucun comptes synchornisé</p>
        }
        <button class="btn-ajouter" @onclick="@SynchroniserBanque">+</button>
    </div>

    <div class="flux @(BVM.AucunCompteBancaire ? "flou" : "")">
        <_BudgetSidebar Model="@BVM" />
    </div>

    <div class="flux-stats @(BVM.AucunCompteBancaire ? "flou" : "")">
        @switch (BVM.StatutMoisActif?.Statut)
        {
            case null:
                <_RecapitulatifGlobal @key="BVM.CompteSelectionne" Model="@BVM" />
                break;
            case Statut.a_completer or Statut.edition:
                <_EditionFluxMensuel Model="@BVM" />
                break;
            case Statut.complete:
                // la cle permet de forcer la mise à jour
                <_RecapitulatifFluxMensuel @key="BVM.StatutMoisActif.Date" Model="@BVM" />
                break;
            case Statut.aucune_donnees:
                <_BudgetGetFlux Model="@BVM" />
                break;
        }
    </div>

</div>


@code {
    private CancellationTokenSource _cts = new();
    [Parameter][SupplyParameterFromQuery(Name = "connection_id")] public int? ConnectionBanqueId { get; set; }
    [Parameter][SupplyParameterFromQuery(Name = "sync")] public string? SyncStatus { get; set; }

    protected override void OnInitialized()
    {
        BVM.OnChange += StateHasChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (SyncStatus == "ok")
        {
            TS.ShowSuccess("Banque synchronisée avec succès !");
            TS.ShowInfo("Synchronisation des flux lancée en arrière-plan ...");
            BankWorker.DeclencherSynchronisationImmediate(BVM.IdUser);
            SyncStatus = null; 
        }
        else if (SyncStatus == "error")
        {
            TS.ShowError("Erreur lors de la synchronisation de la banque, veuillez réessayer plus tard.");
            SyncStatus = null;
        }

        if (ConnectionBanqueId != null)
        {
            var id = ConnectionBanqueId.Value;
            ConnectionBanqueId = null;
            await FinaliserAjoutBanque();
        }
        else if (string.IsNullOrEmpty(SyncStatus))
        {
            await BVM.StartLoadData();
        }
    }

    private async Task SynchroniserBanque()
    {
        await BVM.InitialiserUrlConnexionPowens();
        Nav.NavigateTo(BVM.UrlConnexionPowens, forceLoad: true);
    }

    private async Task FinaliserAjoutBanque()
    {
        await BVM.FinaliserAjoutBanque(ConnectionBanqueId!.Value);
        if (BVM.HasErreur)
        {
            Nav.NavigateTo("/budget?sync=error", replace: true);
            return;
        }

        Nav.NavigateTo("/budget?sync=ok", replace: true);
    }

    public void Dispose()
    {
        BVM.OnChange -= StateHasChanged;
        _cts.Cancel();
        _cts.Dispose();
    }
}

