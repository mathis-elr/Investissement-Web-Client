@page "/budget"
@using Investissement_WebClient.Web.Components.ViewsModels.Budget
@attribute [Authorize]
@inject NavigationManager Nav
@inject BudgetViewModel BVM
@inject IToastService TS
@implements IDisposable

<PageTitle>Budget</PageTitle>

<div class="budget">

    <div class="flux">
        <_BudgetSidebar Model="@BVM" />
    </div>

    <div class="flux-stats">
        @switch (BVM.StatutMoisActif?.Statut)
        {
            case null:
                <_RecapitulatifGlobal Model="@BVM" />
                break;
            case Statut.a_completer or Statut.edition:
                <_EditionFluxMensuel Model="@BVM" />
                break;
            case Statut.complete:
                <_RecapitulatifFluxMensuel @key="BVM.StatutMoisActif.Date" Model="@BVM" /> // la cle permet de forcer la mise à jour
                break;
            case Statut.aucune_donnees:
                <_BudgetGetFlux Model="@BVM" />
                break;
        }
    </div>

</div>


@code {
    [Parameter][SupplyParameterFromQuery(Name = "sync")] public string? SyncStatus { get; set; }

    protected override async Task OnInitializedAsync()
    {
        BVM.OnChange += StateHasChanged;

        await BVM.StartLoadData();

        if (SyncStatus == "ok")
            await SynchronisationBanque();

        if (BVM.ConnexionBanqueRequise)
            TS.ShowWarning("ℹ️ Synchronisation avec vôtre banque requise pour récuperer les flux mensuel.");
    }

    public async Task SynchronisationBanque()
    {
        TS.ShowSuccess("Connexion à votre banque réussie, vous pouvez récuperer vos flux");

        await Task.Delay(2000);

        TS.ShowInfo("récupération des transactions en cours ...");
        var ajd = DateTime.Now;
        var minDate = new DateTime(year: ajd.Year,
                                   month: ajd.AddMonths(-2).Month,
                                   day: 1); // le premier d'il y a deux mois
        var maxDate = new DateTime(year: ajd.Year,
                                   month: ajd.AddMonths(-1).Month,
                                   day: DateTime.DaysInMonth(ajd.Year, ajd.AddMonths(-1).Month)); // le dernier jour du mois dernier

        await BVM.GetFlux(minDate, maxDate);

        if (BVM.HasErreur)
            TS.ShowError("Erreur lors de la récupération des flux, veuillez réessayer plus tard.");
        else
        {
            TS.ShowSuccess("Récupération des flux terminée.");
            // BVM.NotifyStateChanged();
        }
            
        await Task.Delay(3000);

        Nav.NavigateTo(Nav.BaseUri, forceLoad: false);
    }

    public void Dispose()
    {
        BVM.OnChange -= StateHasChanged;
    }
}