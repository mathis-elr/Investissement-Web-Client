<div class="un-compte @(Selectionne?.Id == Compte.Id ? "actif" : "")" @onclick="@OnClick">
    <span class="banque">@Compte.NomSource</span>
    <span class="compte">@Compte.NomCompte</span>
</div>

@code {
    [Parameter] public required SourceDto Compte { get; set; }
    [Parameter] public required SourceDto? Selectionne { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
}
