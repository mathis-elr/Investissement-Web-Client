<div class="header">
    <label>Historique</label>
</div>

<div class="un-mois recap @(Model.DateActive == null ? "active-recapitulatif-global " : "")"
     @onclick="Model.SetRecapGlobal">
    <span>Récapitulatif global</span>
</div>

<div class="content">

    @foreach (var unMois in Model.StatutsParMois)
    {
        var estIndisponible = false;
        var icon = string.Empty;
        var statut = string.Empty;
        @switch (unMois.Statut)
        {
            case Statut.indisponible:
                estIndisponible = true;
                icon = "indisponible";
                statut = "indisponible";
                break;
            case Statut.a_completer:
                icon = "non-complete";
                statut = "à compléter";
                break;
            case Statut.complete:
                icon = "complete";
                statut = "complété";
                break;
            case Statut.aucune_donnees:
                icon = "aucune-donnee";
                statut = "aucune données";
                break;
            case Statut.edition:
                icon = "edition";
                statut = "édition";
                break;
        }

        var estActif = Model.DateActive.HasValue
        && Model.DateActive.Value.Year == unMois.Date.Year
        && Model.DateActive.Value.Month == unMois.Date.Month;

        <div class="un-mois @(estIndisponible  ? "disabled" : estActif ? "active" : "")"
             @onclick="() => { if (!estIndisponible) { Model.LoadFluxUnMois(unMois); } }"
             title="@(estIndisponible ? $"Vous pourrez voir vos flux à partir du 5 {unMois.Date.AddMonths(1).ToString("MMMM yyyy")}" : "Cliquer pour consulter les flux du mois")">

            <div class="gauche">
                <img src='/icons/@(icon + ".svg")' />
                <span class="mois">@unMois.Date.ToString("MMMM yyyy")</span>
            </div>
            <span class="statut-badge">@statut</span>
        </div>
    }
</div>

@code {
    [Parameter] public required CompteCourantViewModel Model { get; set; }
}
