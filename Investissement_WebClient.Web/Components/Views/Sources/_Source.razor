<div class="un-compte @(Selectionne?.Id == Source.Id ? "actif" : "")" @onclick="@OnClick">
    <span class="banque">@Source.Nom</span>
    <span class="compte">@Source.Nom</span>
</div>

@code {
    [Parameter] public required CompteBanqueDto Source { get; set; }
    [Parameter] public required CompteBanqueDto? Selectionne { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
}
