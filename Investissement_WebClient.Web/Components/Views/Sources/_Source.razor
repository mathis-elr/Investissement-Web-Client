<div class="un-compte @(Selectionne?.Id == Source.Id ? "actif" : "")" @onclick="@OnClick">
    <div class="icon">
        <img src="@Source.LogoUrl" />
    </div>
    <div class="infos">
        <span class="banque">@Source.NomSource</span>
        <span class="compte">@Source.NomCompte</span>
    </div>
</div>

@code {
    [Parameter] public required SourceDto Source { get; set; }
    [Parameter] public required SourceDto? Selectionne { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
}
