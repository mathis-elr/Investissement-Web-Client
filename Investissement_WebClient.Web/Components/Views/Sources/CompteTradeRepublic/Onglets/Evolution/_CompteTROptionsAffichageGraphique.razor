<div class="bloc-options">
    @foreach (var periode in Model.PeriodesPossibles)
    {
        <div class="option">
            <span @onclick="async () => { await Model.ChangerPeriodeSelectionnee(periode); }"
                  class="@(Model.PeriodeSelectionnee == periode ? "active" : "")">
                @Model.GetLibellePeriode(periode)
            </span>
        </div>
    }
</div>

