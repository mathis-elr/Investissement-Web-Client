<div class="bloc-options">
    @foreach (var typeGraphique in Model.TypeGraphiquesPossibles)
    {
        bool actif = Model.TypeGraphiqueSelectionnee == typeGraphique;

        <div class="option">
            <span @onclick="async () => await Model.ChangerTypeGraphiqueSelectionnee(typeGraphique)"
                  class="@(actif ? "active" : "")">
                <img class="icone-option" src="@(Model.GetIconeTypeGraphique(typeGraphique, actif))" />
            </span>
        </div>
    }
</div>

@code{
    [Parameter] public required TradeRepublicEvolutionViewModel Model { get; set; }
}
