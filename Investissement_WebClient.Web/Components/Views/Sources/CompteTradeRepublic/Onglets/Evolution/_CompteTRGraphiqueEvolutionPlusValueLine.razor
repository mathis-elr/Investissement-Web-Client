@*Graphique Line : evolution des plus/moins values au cours du temps par rapport à l'investissement total et à la valeur du patrimoine*@

@if (PointsPlusValue.Any())
{
    <ApexChart TItem="PointChartDto"
               XAxisType="XAxisType.Datetime"
               Options="PatrimoineChartsOptions.OptionsPointsPlusValue">

        <ApexPointSeries TItem="PointChartDto"
                         Items="PointsPlusValue"
                         Name="Valeur"
                         SeriesType="SeriesType.Line"
                         XValue="@(e => e.Date)"
                         YValue="@(e => e.Valeur)"
                         OrderByDescending="e => e.X" />
    </ApexChart>
}
else
{
    <_Chargement Couleur="black" />
}

@code {
    [Parameter] public IEnumerable<PointChartDto> PointsPlusValue { get; set; } = [];
}
