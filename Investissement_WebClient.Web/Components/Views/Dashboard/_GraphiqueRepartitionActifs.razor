@* Pie : proportion investit par actif par rapport au total investit *@

@if (Model.ValeurParActifInvestit.Any())
{
    <ApexChart TItem="ValeurTotaleParActifDto"
               Options="DashboardChartsOptions.OptionsPieActif">

        <ApexPointSeries TItem="ValeurTotaleParActifDto"
                         Items="Model.ValeurParActifInvestit"
                         SeriesType="SeriesType.Donut"
                         XValue="@(e => e.Actif)"
                         YValue="@(e => e.Valeur)"
                         OrderByDescending="e => e.Y"
                         ShowDataLabels />
    </ApexChart>
}
else if (Model.RecuparationEnCours)
{
    <_ChargementGraphique />
}
else
{
    <p>Vous n'investissez dans aucun actif, rendez vous dans la rubrique "Investissement" pour récuperer vos flux.</p>

}
    

@code {
    [Parameter] public required DashboardViewModel Model { get; set; }
}
