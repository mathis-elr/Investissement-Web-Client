@page "/"
@attribute [Authorize]
@inject DashboardViewModel DVM
@inject IJSRuntime JS
@inject IToastService TS
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<PageTitle>Dashboard</PageTitle>

<div class="profil">
    <div class="perspectives">
        <div class="header">
            <label>Perspectives</label>
        </div>

        <div class="content">
            <div class="perspectives-infos">
                <div class="form-grid">
                    <label>Investissement mensuel</label>
                    <div class="info">
                        <input @bind="DVM.InvestissementMoyenMensuel" @bind:event="oninput" @onchange="CalculerEvolutionDuPatrimoine" />
                    </div>
                    <label>€</label>

                    <label>Evolution Annuelle</label>
                    <div class="info">
                        <input @bind="DVM.EvolutionAnnuellePourcentage" @bind:event="oninput" @onchange="CalculerEvolutionDuPatrimoine" />
                    </div>
                    <label>%</label>

                    <label>Nombre d'années</label>
                    <div class="info">
                        <input @bind="DVM.PerspectiveNbAnnees" @bind:event="oninput" @onchange="CalculerEvolutionDuPatrimoine" />
                    </div>
                    <label>ans</label>
                </div>
            </div>

            <div class="perspectives-graphique @(DVM.RecuparationEnCours ? "center" : "")">
                @if (DVM.RecuparationEnCours)
                {
                    <_ChargementGraphique />
                }
                else
                {
                    <_GraphiquePerspectivePatrimoine Model="@DVM" />
                }
            </div>
        </div>
    </div>

    <div class="info-compte">
        <div class="header">
            <label>Bonjour @(DVM.PrenomUser != string.Empty ? DVM.PrenomUser : "")</label>
            <button class="btn-deconnexion" title="Déconnexion" @onclick="Deconnexion"><img src="icons/logout.svg" /></button>
        </div>

        <div class="content @(!DVM.ValeurParActifInvestit.Any() ? "flou" : "")">
            <div class="info">
                <img src="icons/wallet.svg" />
                <span>Valeur Actuelle</span>
                <span class="blanc fw-bolder">
                    @(DVM.ValeurPatrimoineCourante == 0 ? "--,--" : DVM.ToStringPourcentage(DVM.ValeurPatrimoineCourante, "C2"))
                </span>
            </div>

            <div class="info">
                <img src="icons/gain.svg" />
                <span>Gain total</span>
                <span class="@DVM.DeterminerClasse(DVM.GainTotal) fw-bolder">
                    @(DVM.GainTotal == 0 ? "--,--": $"{(DVM.GainTotal > 0 ? "+" : "")}{DVM.ToStringPourcentage(DVM.GainTotal, "C2")}")
                </span>
            </div>

            <div class="info">
                <img src="icons/asset.svg" />
                <span>Actifs suivis</span>
                <span class="blanc fw-bolder">
                    @DVM.NombreActifs
                </span>
            </div>

            <div class="info">
                <img src="icons/calendar.svg" />
                <span>Investisseur depuis</span>
                <span class="blanc fw-bolder">
                    @DVM.NombreAnnes ans
                    et
                    @DVM.NombreMois mois
                </span>
            </div>
        </div>
    </div>

    <div class="repartition-actifs">

        @if (!DVM.ValeurParActifInvestit.Any())
        {
            <div class="bloc-empty">
                <_EmptyStateCard Icone="icons/asset.svg"
                                 Titre="Vous n'investissez dans aucun actif"
                                 Description="Pour afficher la répartition de vos actifs, synchronisez d'abord vos flux."
                                 TexteBouton="Accéder à Investissement"
                                 InfoBulle="Synchronisez vos actifs."
                                 OnClick="@(() => Nav.NavigateTo("investissement", forceLoad: true))" />
            </div>
        }

        <div class="header @(!DVM.ValeurParActifInvestit.Any() ? "flou" : "")">
            <label>Allocation</label>
        </div>

        <div class="graphique @(DVM.RecuparationEnCours ? "center" : "") @(!DVM.ValeurParActifInvestit.Any() ? "flou" : "")">
            @if (DVM.RecuparationEnCours)
            {
                <_ChargementGraphique />
            }
            else
            {
                <_GraphiqueRepartitionActifs Model="@DVM" />
            }
        </div>
    </div>
</div>

@code {
    private CancellationTokenSource _cts = new();
    [Parameter][SupplyParameterFromQuery(Name = "creation")] public string? CreationStatus { get; set; }

    protected override async Task OnInitializedAsync()
    {
        DVM.OnChange += StateHasChanged;

        if (CreationStatus == "succes")
            TS.ShowSuccess("Votre compte a été créé avec succès !");

        await DVM.LoadData();
       
        if (DVM.HasError)
        {
            TS.ShowError(DVM.ErrorMessage);
            DVM.HasError = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ = LoadDataBoucle(_cts.Token);
        }
    }

    private async Task LoadDataBoucle(CancellationToken stoppingToken)
    {
        try
        {
            while (!stoppingToken.IsCancellationRequested)
            {
                await DVM.LoadInfosProfil();
                StateHasChanged();
                await Task.Delay(TimeSpan.FromSeconds(10), stoppingToken);
            }
        }
        catch (OperationCanceledException) { }
    }

    public void CalculerEvolutionDuPatrimoine()
    {
        DVM.CalculerEvolutionDuPatrimoine();

        if (DVM.HasError)
        {
            TS.ShowError(DVM.ErrorMessage);
            DVM.HasError = false;
            DVM.ErrorMessage = string.Empty;
        }
    }

    public async Task Deconnexion()
    {
        var customAuthStateProvider = (CustomAuthStateProvider)AuthStateProvider;
        await customAuthStateProvider.UpdateAuthenticationState(null);

        Nav.NavigateTo("connexion");
    }

    public void Dispose()
    {
        DVM.OnChange -= StateHasChanged;
        _cts.Cancel();
        _cts.Dispose();
    }

}