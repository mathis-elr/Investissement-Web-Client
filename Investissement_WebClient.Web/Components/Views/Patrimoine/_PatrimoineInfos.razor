
<div class="resume-patrimoine">
    <img src="icons/gain.svg" />

    <div class="infos-patrimoine">
        <span class="valeur-totale-courante">
            <label>
                @(Model.ValeurPatrimoineCourante == 0 ? "--,--" : Model.ToStringPourcentage(Model.ValeurPatrimoineCourante, "C2"))
            </label>
        </span>

        <span class="gain-total @Model.DeterminerClasse(Model.GainTotal)">
            <span>
                @(Model.GainTotal == 0 ? "--,--" : Model.ToStringPourcentage(Model.GainTotal, "C2"))
            </span>
            <label>depuis le départ</label>
        </span>
    </div>
</div>

<div class="variations-prix">
    @foreach (var variation in Model.Variations)
    {
        <span class="variation-prix @Model.DeterminerClasse(variation.VariationValeure)">
            <label>@variation.Periode.ToString()</label>
            @Model.ToStringPourcentage(variation.VariationPourcentage, "P2")
            @variation.VariationValeure.ToString("C2")
        </span>
    }
</div>

@code {
    [Parameter] public required PatrimoineViewModel Model { get; set; }
}
