@page "/patrimoine"
@attribute [Authorize]
@implements IDisposable
@inject IToastService TS
@inject PatrimoineViewModel PVM

<PageTitle>Patrimoine</PageTitle>

<div class="patrimoine">
    
    <div class="patrimoine-infos">
        <_PatrimoineInfos Model="@PVM" />
    </div>

    <div class="patrimoine-graphique">

        @* @if(PVM.ValeurPatrimoineCourante != 0)
        {
            <div class="btn-rond precedent" @onclick="GraphiquePrecedent"><img src="icons/precedent.png"></div>
            <div class="btn-rond suivant" @onclick="GraphiqueSuivant"><img src="icons/suivant.png"></div>
        } *@

        <div class="options">
            <_OptionsAffichageGraphique Model="PVM" />
        </div>

        @if (PVM.RecuparationEnCours)
        {
            <div class="graphique graphique-centre">
                <_ChargementGraphique />
            </div>
        }
        else if (PVM.ValeurPatrimoineCourante == 0)
        {
            <div class="graphique graphique-centre">
                <p>Récuperer vos flux pour commencer à visualiser l'évolution de vôtre patrimoine.</p>
            </div>
        }
        else
        {
            <div class="graphique">
                @if (PVM.TypeGraphiqueSelectionnee == TypeGraphique.Candle)
                {
                    <_GraphiqueEvolutionPlusValueCandle BougiesPlusValue="@PVM.BougiesPlusValue" />
                }
                else
                {
                    <_GraphiqueEvolutionPlusValueLine PointsPlusValue="@PVM.PointsPlusValue" />
                }
            </div>
        }

        @* <div class="rail @(graphiques[index])">
            
            @if (PVM.RecuparationEnCours)
            {
                <div class="page">
                    <div class="recherche-donnee">            
                        <_ChargementGraphique />
                    </div>
                </div>
            }
            else if (PVM.ValeurPatrimoineCourante == 0)
            {
                <div class="page">
                    <div class="recherche-donnee">
                        <p>Récuperer vos flux pour commencer à visualiser l'évolution de vôtre patrimoine.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="page">
                    <div class="options">
                        <_OptionsAffichageGraphique Model="PVM" />
                    </div>

                    @if(PVM.TypeGraphiqueSelectionnee == TypeGraphique.Candle)
                    {
                        <_GraphiqueEvolutionPlusValueCandle BougiesPlusValue="@PVM.BougiesPlusValue" />
                    }
                    else
                    {
                        <_GraphiqueEvolutionPlusValueLine PointsPlusValue="@PVM.PointsPlusValue" />
                    }
                </div>

                <div class="page">
                    <_GraphiqueRepartitionActifs ValeurParActifInvestit="@PVM.ValeurParActifInvestit" />
                </div>

                <div class="page">
                    <_GraphiqueValeurPatrimoineSurInvestissement BougiesJournalieresValeurPatrimoineSurInvestissementTotal="PVM.BougiesJournalieresValeurPatrimoineSurInvestissementTotal" />
                </div>
            }
        </div> *@
    </div>
</div>

@code {
    private CancellationTokenSource _cts = new();
    private List<string> graphiques = ["graph1", "graph2", "graph3"];
    private int index =  0;   

    protected override async Task OnInitializedAsync()
    {
        PVM.OnChange += StateHasChanged;

        await PVM.StartLoadData();

        if (PVM.ValeurPatrimoineCourante == 0) 
            TS.ShowWarning("ℹ️ Commencez à recupérer vos flux dans 'Investissement' pour pouvoir suivre l'évolution de vôtre patrimoine");

        if (PVM.HasError)
        {
            TS.ShowError(PVM.ErrorMessage);
            PVM.HasError = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ = LoadDataBoucle(_cts.Token);
        }
    }

    private async Task LoadDataBoucle(CancellationToken stoppingToken)
    {
        try
        {
            while (!stoppingToken.IsCancellationRequested)
            {
                await PVM.StartLoadData();
                StateHasChanged();
                await Task.Delay(TimeSpan.FromSeconds(10), stoppingToken); // les données de yahoo ne se mettent pas à jour plus régulièrement que 1mn
            } 
        }
        catch(OperationCanceledException){ }
    }

    // déclenchement lors du déclenchement du catch de LoadData (quand on change de page) pour stopper la boucle
    public void Dispose()
    {
        PVM.OnChange -= StateHasChanged;
        _cts.Cancel();
        _cts.Dispose(); 
    }

    private void GraphiqueSuivant()
    {
        index = (index + 1) % graphiques.Count();
    }
    private void GraphiquePrecedent()
    {
        var nbGraph = graphiques.Count();
        index = (index - 1 + nbGraph) % nbGraph;
    }
}
