<div class="header">
    <label>Historique d'investissement</label>

    <div class="info-invest-total">
        <span class="goldenrod">@(Model.InvestissementTotal == 0 ? "--,--" : Model.InvestissementTotal.ToString("C"))</span>
        <span class="gris">investis au total</span>
    </div>
</div>


<div class="content">
    <div class="header">
        <div class="infos-invest">

            <div class="info-invest">
                <div class="variation">
                    <span class="white">@(Model.InvestissementMedianMensuel == 0 ? "--,--" : Model.InvestissementMedianMensuel.ToString("C"))</span>
                    <span class="gris">
                        médiane
                    </span>
                </div>
                <span class="gris">sur @Model.NombreMoisInvestissement mois</span>
            </div>

            <div class="info-invest">
                <div class="variation">
                    <span class="goldenrod">
                        @(Model.InvestissementMoisEnCours == 0 ? "--,--" : Model.InvestissementMoisEnCours.ToString("C"))
                    </span>
                    <span class="gris">ce mois-ci</span>
                </div>

                <div class="variation">
                    <span class="@(Model.InvestissementMedianMensuel == Model.InvestissementMoisEnCours ? "gris" : Model.InvestissementMedianMensuel > Model.InvestissementMoisEnCours ? "rouge" : "vert")">
                        @(Model.InvestissementMedianMensuel == Model.InvestissementMoisEnCours ? "" : Model.InvestissementMedianMensuel < Model.InvestissementMoisEnCours ? "↗" : "↘")
                        @(Model.TauxEvolutionMoisCourantEtMedianne == 0 ? "--,--" : Model.TauxEvolutionMoisCourantEtMedianne.ToString("P1"))
                    </span>

                    <span class="gris">
                        vs médiane
                    </span>
                </div>
            </div>
        </div>

        <div class="bloc-options">
            @foreach (var periode in Model.PeriodeHistoriqueInvestPossibles)
            {
                <div class="option">
                    <span @onclick="async () => { await Model.ChangerPeriodeHistoriqueInvestSelectionnee(periode); }"
                          class="@(Model.PeriodeHistoriqueInvestSelectionnee == periode ? "active" : "")">
                        @Model.GetLibellePeriodeHistoriqueInvest(periode)
                    </span>
                </div>
            }
        </div>
    </div>

    @if (Model.ChargementEncours || Model.ChargementGraphique)
    {
        <div class="graphique graphique-centre">
            <_ChargementGraphique />
        </div>
    }
    else if (Model.InvestissementsParMois.Any())
    {
        <div class="graphique">
            <_GraphiqueInvestissementParMoisLine Model="Model" />
        </div>
    }
    else
    {
        <div class="graphique graphique-centre">
            <p>Aucun investissement effecuté.</p>
        </div>
    }
</div>



@code {
    [Parameter] public required InvestissementViewModel Model { get; set; }
}
