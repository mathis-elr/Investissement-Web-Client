@inject IToastService TS

<div class="header">
    @if (!_afficherFormulaire && !Model.DemandeEnCours)
    {
        <label>Transactions</label>
    }
    else if (Model.DemandeEnCours)
    {
        <label>Synchronisation Trade Republic</label>
    }
    else
    {
        <label>Configuration Trade Republic</label>
    }

    @if (!Model.IdentifiantsRequis && !_afficherFormulaire && !Model.DemandeEnCours)
    {
        <div class="btn-edit" title="Editer mes identifiants" @onclick="() => _afficherFormulaire = true">
            <img style="width:35%" src="icons/parametres.png" />
        </div>
    }
</div>

<div class="transactions-infos">
    @if (_afficherFormulaire)
    {
        <_ConfigurationTR Model="@Model" OnAnnuler="MasquerFormulaire" />
    }
    else if (Model.Etat == Etat.SmsRequis)
    {
        <p>Vous allez recevoir une notification contenant un code de la part de Trade Republic sur vôtre téléphone, renseignez ce code de 4 chiffres et cliquez sur "Vérifier".</p>

        <div class="form-grid">
            <label>Code sms</label>
            <div class="info">
                <input type="text" inputmode="numeric" maxlength="4" @bind="Model.CodeSms" placeholder="ex : 1234" />
            </div>
            <button type="button" class="btn-verifier" @onclick="VerifierCodeSms">
                @if (Model.VerificationEnCours)
                {
                    <_Chargement />
                }
                else
                {
                    <div>Vérifier</div>
                }
            </button>
        </div>
    }
    else
    {
        <button class="btn-submit" @onclick="RecupererTransactions" disabled="@(Model.DemandeEnCours || Model.IdentifiantsRequis)">
            @if (Model.DemandeEnCours)
            {
                <_Chargement Couleur="black" />
            }
            else
            {
                <img src="icons/sync.svg" />
                <span>Synchroniser mes transactions</span>
            }
        </button>

        @if (Model.DemandeEnCours)
        {
            <p>@Model.Message</p>
        }
    }
</div>

@if (!Model.DemandeEnCours || !Model.FluxInvestissement.Any() && _afficherFormulaire)
{
    <div class="filtres">
        <div class="recherche">
            <img src="icons/aucune-donnee.svg" />
            <input type="text" @bind="Model.TexteRecherche" @bind:event="oninput" placeholder="Rechercher une transaction ..." />
        </div>
    </div>
}

<div class="content">

    @if (Model.ChargementEncours)
    {
        <div class="center">
            <p><_Chargement Couleur="goldenrod" LargeurBouton="50"/></p>
        </div>
    }
    else if (Model.FluxInvestissement.Any() && _afficherFormulaire || Model.DemandeEnCours)
    {

    }
    else if (Model.IdentifiantsRequis)
    {
        <p>Vous pourez consulter vos transactions ici dès que vous aurez enregistré vos identifiants Trade Republic et récuperer vos transactions.</p>

    }
    else if (Model.FluxInvestissement.Any())
    {
        @foreach (var transactionsParDate in Model.FluxInvestissementFiltres.GroupBy(i => i.Date.Date).OrderByDescending(i => i.Key)!)
        {
            <div class="mes-transactions-par-jour">
                <div class="mes-transactions-par-jour-header">
                    <div class="left">
                        <label>@transactionsParDate.Key.ToString("D") &nbsp</label>
                        <div class="ordres">
                            <span>@transactionsParDate.Count() ordre@(transactionsParDate.Count() > 1 ? "s" : "")</span>
                        </div>
                    </div>

                    <label class="goldenrod">@(transactionsParDate.Sum(tr => tr.Prix * tr.Quantite).ToString("C2"))</label>
                </div>
                <div class="mes-transactions-par-jour-content">
                    @foreach (var transaction in transactionsParDate)
                    {
                        <div class="une-transaction">
                            <div class="icon">
                                <img src="@transaction.Logo" />
                            </div>
                            <div class="grid-start">
                                <span>@transaction.Actif</span>
                                <span class="@(Model.DeterminerClasse(transaction.Quantite))">@(transaction.Quantite > 0 ? "+" : "")@transaction.Quantite titre@(transaction.Quantite > 1 ? "s" : "")</span>
                            </div>
                            <div class="grid-end">
                                <span class="prix">@transaction.Prix.ToString("C")</span>
                                <span class="gris">valeur unitaire</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <p>Aucune synchornisation effectué avec Trade Republic, cliquez sur "Synchroniser mes transactions" pour récuperez vos flux.</p>
    }
</div>

@code {
    [Parameter] public required InvestissementViewModel Model { get; set; }

    private bool _afficherFormulaire { get; set; } = false;

    private async Task RecupererTransactions()
    {
        if (Model.DemandeEnCours)
        {
            TS.ShowError("Veuillez patienter, une demande est déjà en cours");
            return;
        }

        await Model.DemandeCodeSms();

        if (Model.HasError)
        {
            Model.FinDeDemande();
            await Task.Yield();
            TS.ShowError(Model.ErrorMessage);
            Model.ReinitiliserGestionErreur();
            return;
        }
    }


    private async Task VerifierCodeSms()
    {
        switch (await Model.VerfierCodeSms())
        {
            case null:
                TS.ShowError(Model.ErrorMessage);
                Model.ReinitiliserGestionErreur();
                break;
            case false:
                TS.ShowWarning("Toutes les transactions ont déjà été récupérées.");
                break;
            default:
                TS.ShowSuccess("Les transactions on été récupérées avec succès !");
                break;

        }

        Model.FinDeDemande();
    }

    private void MasquerFormulaire()
    {
        _afficherFormulaire = false;
    }
}
