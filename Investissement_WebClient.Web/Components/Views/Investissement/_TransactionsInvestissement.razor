@inject IToastService TS

<div class="header">
    <label>Transactions</label>
    @if (!Model.IdentifiantsRequis && !_afficherFormulaire)
    {
        <div class="btn-edit" title="Editer mes identifiants" @onclick="() => _afficherFormulaire = true">
            <img style="width:40%" src="parametres.png" />
        </div>
    }
</div>

<div class="transactions-infos">
        @if (Model.IdentifiantsRequis || _afficherFormulaire)
        {
            <_FormIdTR Model="@Model" OnAnnuler="MasquerFormulaire"/>
        }
        else if (Model.Etat == Etat.SmsRequis)
        {
            <div class="form-grid">
                <label>Code sms</label>
                <div class="info">
                    <input type="text" inputmode="numeric" maxlength="4" @bind="Model.CodeSms" placeholder="ex : 1234" />
                </div>
                <button type="button" class="btn-verifier" @onclick="VerifierCodeSms">
                    @if (Model.VerificationEnCours)
                    {
                        <_Chargement />
                    }
                    else
                    {
                        <div>Vérifier</div>
                    }
                </button>
            </div>
        }
        else
        {
            <div class="infos">
                <button class="btn-submit" @onclick="RecupererTransactions" disabled="@(Model.DemandeEnCours || Model.IdentifiantsRequis)">
                    @if (Model.DemandeEnCours) { <_Chargement Couleur="black" /> }
                    else { <span>Récuperer transactions</span> }
                </button>
    
                <p>@Model.Message</p>
            </div>
        }
</div>

<div class="content">
    @if (Model.ChargementEncours)
    {
        <div class="center">
            <p><_Chargement Couleur="goldenrod" LargeurBouton="50"/></p>
        </div>
    }
    else if (Model.IdentifiantsRequis)
    {
        <p>Vous pourez consulter vos transactions ici dès que vous aurez enregistré vos identifiants Trade Republic et récuperer vos transactions.</p>
    }
    else if (Model.FluxInvestissement.Any())
    {
        @foreach (var transactionsParDate in Model.FluxInvestissement.GroupBy(i => i.Date.Date).OrderByDescending(i => i.Key)!)
        {
            <div class="mes-transactions-par-jour">
                <div class="mes-transactions-par-jour-header">
                    <label>@transactionsParDate.Key.ToString("D") &nbsp</label>
                    <span></span>
                    <label>@(transactionsParDate.Sum(tr => tr.Prix * tr.Quantite).ToString("C2"))</label>
                </div>
                <div class="mes-transactions-par-jour-content">
                    @foreach (var transaction in transactionsParDate)
                    {
                        <div class="une-transaction">
                            <span></span>
                            <span class="quantite @(@transaction.Quantite > 0 ? "vert" : "rouge")">@transaction.Quantite&nbsp</span>
                            <span class="actif">@transaction.Actif à&nbsp</span>
                            <span class="prix">@transaction.Prix.ToString("C")</span>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <p>Commencez dès maintenant à suivre vos investissement en cliquant sur le bouton "Récuperer mes transactions"</p>
    }
</div>

@code {
    [Parameter] public required InvestissementViewModel Model { get; set; }

    private bool _afficherFormulaire { get; set; } = false;

    private async Task RecupererTransactions()
    {
        if (Model.DemandeEnCours)
        {
            TS.ShowError("Veuillez patienter, une demande est déjà en cours");
            return;
        }

        await Model.DemandeCodeSms();

        if (Model.HasError)
        {
            Model.FinDeDemande();
            await Task.Yield();
            TS.ShowError(Model.ErrorMessage);
            Model.ReinitiliserGestionErreur();
            return;
        }

        TS.ShowSuccess(Model.Message);
    }


    private async Task VerifierCodeSms()
    {
        switch (await Model.VerfierCodeSms())
        {
            case null:
                TS.ShowError(Model.ErrorMessage);
                Model.ReinitiliserGestionErreur();
                break;
            case false:
                TS.ShowWarning("Toutes les transactions ont déjà été récupérées.");
                break;
            default:
                TS.ShowSuccess("Les transactions on été récupérées avec succès !");
                break;

        }

        Model.FinDeDemande();
    }

    private void MasquerFormulaire()
    {
        _afficherFormulaire = false;
    }
}
