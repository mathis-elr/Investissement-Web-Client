<div class="un-actif">
    <div class="header">
        <div class="icon">
            <img src="@Actif.Logo" />
        </div>
        <label>@Actif.Actif</label>
    </div>
    <div class="content">
        @{
            (string couleurVarVal, string signeVarVal) = DeterminerSigne(Actif.VariationValeur);
            (string couleurVarPour, string signeVarPour) = DeterminerSigne(Actif.VariationPourcentage);
        }

        <div class="info">
            <label class="goldenrod">
                @Actif.ValeurDetenue.ToString("C", CultureInfo.GetCultureInfo("fr-FR"))
            </label>
            <span class="gris">
                Valeur actuelle
            </span>
        </div>

        <div class="info">
            <label class="@couleurVarVal">
                @(signeVarVal + Actif.VariationValeur.ToString("C", CultureInfo.GetCultureInfo("fr-FR")))
            </label>
            <span class="gris">
                Gain
            </span>
        </div>

        <div class="info">
            <label class="@couleurVarPour">
                @(signeVarVal + Actif.VariationPourcentage + "%")
            </label>
            <span class="gris">
                Performance
            </span>
        </div>
    </div>
</div>

@code{
    [Parameter] public InfoParActifDto Actif { get; set; } = null!;

    (string, string) DeterminerSigne(decimal valeur)
    {
        return valeur switch
        {
            > 0 => ("vert", "+"),
            < 0 => ("rouge", ""),
            _ => ("gris", "")
        };
    }
 }