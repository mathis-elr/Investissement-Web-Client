@page "/investissement"
@attribute [Authorize]
@inject NavigationManager Nav
@inject InvestissementViewModel IVM
@implements IDisposable
@inject IJSRuntime JS
@inject IToastService TS

<PageTitle>Investissement</PageTitle>


@if (IVM.IdentifiantsRequis)
{
    <div class="bloc-empty">
        <_ConfigurationTR Model="@IVM" />
    </div>
}

<div class="investissement">
    <div class="transactions @(IVM.IdentifiantsRequis ? "flou" : "")">
        <_TransactionsInvestissement Model="@IVM" />
    </div>

    <div class="evolution-actifs @(IVM.IdentifiantsRequis ? "flou" : "")">
        @if (IVM.ChargementEncours)
        {
            <div class="center">
                <_Chargement Couleur="goldenrod" LargeurBouton="50" />
            </div>
        }
        else if (IVM.InfoParActifPeriodeAll.Any())
        {
            <div class="mes-actifs">
                <_EvolutionActifs InfoInvestParActif="@IVM.InfoParActifPeriodeAll" />
                <_EvolutionActifs InfoInvestParActif="@IVM.InfoParActifPeriodeAll" />
            </div>
        }
        else
        {
            <div class="center p-4">
                <p>Ici vous pourrez voir l'évolution de tous les actifs dans lesquels vous investissez...</p>
            </div>
        }
    </div>

    <div class="investissement-moyen @(IVM.IdentifiantsRequis ? "flou" : "")">
        <_InvestissementsHistorique Model="@IVM" />
    </div>
</div>


@code{
    private CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        IVM.OnChange += StateHasChanged;
        await IVM.LoadData();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && IVM.FluxInvestissement.Any())
        {
            _ = LoadDataBoucle(_cts.Token);
        }
    }

    private async Task LoadDataBoucle(CancellationToken stoppingToken)
    {
        try
        {
            while (!stoppingToken.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromMinutes(1), stoppingToken);

                await IVM.LoadDataPrixParActif();
                StateHasChanged();
            }
        }
        catch (OperationCanceledException) { Console.WriteLine("Arret du chargement investissement"); }
    }

    public void Dispose()
    {
        IVM.OnChange -= StateHasChanged;
        _cts.Cancel();
        _cts.Dispose();
    }
}

