@inject IToastService TS

<EditForm Model="@Model.TradeRepublicAcces" 
          OnValidSubmit="TentativeEnregistrement"
          OnInvalidSubmit="AfficherErreursToast">

    <DataAnnotationsValidator />

    @if (!Model.IdentifiantsRequis)
    {
        <button class="btn-retour" title="Retour aux transactions" @onclick="FermerEdition">
            <img src="icons/back.svg" />
        </button>
    }
    else
    {
        <label>Configuration Trade Republic</label>
    }

    <span class="description">
        Renseignez vos informations de connexion afin de pouvoir synchroniser vos transactions Trade Republic.
    </span>

    <div class="form-grid">
        <label>Num tel</label>
        <div class="champ">
            <span class="prefix">+33</span>
            <InputText @bind-Value="Model.TradeRepublicAcces.NumTel" placeholder="7 07 07 07 07" maxlength="9" />
        </div>

        <label>Pin</label>
        <div class="champ">
            <InputText @bind-Value="Model.TradeRepublicAcces.Pin" type="password" placeholder="0123" maxlenght="4" />
        </div>
    </div>

    <button class="btn-submit" disabled="@IsLoading">
        @if (IsLoading)
        {
            <_Chargement Couleur="black" />
        }
        else
        {
            <img src="icons/save.svg" />
            <span>Enregistrer</span>
        }
    </button>

    <div class="security-card">
        <div class="security-item">
            <img src="icons/lock.svg" class="sec-icon" alt="" />
            <span>Données chiffrées et confidentielles</span>
        </div>
        <div class="security-item">
            <img src="icons/shield.svg" class="sec-icon" alt="" />
            <span>Accès en lecture seule (aucun retrait ou achat possible)</span>
        </div>
        <div class="security-item">
            <img src="icons/phone.svg" class="sec-icon" alt="" />
            <span>Confirmation requise via votre mobile lors de la synchronisation</span>
        </div>
    </div>
</EditForm>

@code{
    [Parameter] public InvestissementViewModel Model { get; set; } = null!;
    [Parameter] public EventCallback OnAnnuler { get; set; }

    public bool IsLoading { get; set; } = false;

    public async Task TentativeEnregistrement()
    {
        IsLoading = true;

        await Model.SaveAccesTR();

        if (Model.HasError)
        {
            TS.ShowError(Model.ErrorMessage);
            Model.HasError = false;
            Model.ErrorMessage = string.Empty;
            IsLoading = false;
            return;
        }

        if (Model.IdentifiantsRequis)
            await Model.LoadIdentifiantsRequis();

        IsLoading = false;
        FermerEdition();
        TS.ShowSuccess("Accès Trade Republic enregistré avec succès !");
    }

    private void AfficherErreursToast(EditContext editContext)
    {
        var erreurs = editContext.GetValidationMessages();

        foreach (var erreur in erreurs)
        {
            TS.ShowError(erreur);
        }
    }

    public void FermerEdition()
    {
        OnAnnuler.InvokeAsync();
    }
}