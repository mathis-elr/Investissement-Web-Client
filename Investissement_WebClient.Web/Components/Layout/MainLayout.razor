@using Investissement_WebClient.Web.GestionSession

@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject SessionService Session
@inject IJSRuntime JS

<_Notification />

<div class="main-layout">
    <nav>
        <div class="slider"></div>
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
            <div class="link">Dashboard</div>
        </NavLink>

        <NavLink class="nav-link" href="/patrimoine">
            <div class="link">Patrimoine</div>
        </NavLink>

        <NavLink class="nav-link" href="/investissement">
            <div class="link">Investissement</div>
        </NavLink>

        <NavLink class="nav-link" href="/budget">
            <div class="link">Budget</div>
        </NavLink>     

        <NavLink class="nav-link" href="/investissementV2">
            <div class="link">Investissement V2</div>
        </NavLink>
    </nav>

    @Body
</div>


@code{
    private string PrenomUser { get; set; } = string.Empty;
    private string AnneeCreation { get; set; } = string.Empty;

    private IJSObjectReference? module;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += NavigationChanged;
        await Session.Initialiser();
        PrenomUser = Session.Prenom;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./Components/Layout/MainLayout.razor.js");

            await module.InvokeVoidAsync("moveSlider");
        }
    }

    private async void NavigationChanged(object? sender,LocationChangedEventArgs e)
    {
        if (module is not null)
        {
            await module.InvokeVoidAsync("moveSlider");
        }
    }
}