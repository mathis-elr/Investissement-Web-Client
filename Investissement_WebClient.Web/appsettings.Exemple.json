    "ConnectionString": "Server=<SERVER>;Database=<DATABASE>;User Id=<USER>;Password=<PASSWORD>;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },

  "Security": {
    "MasterKey": ""
  },

  "PowensApi": {
